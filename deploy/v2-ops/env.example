# Copy to a root-readable env file outside Git and replace every value.
V2_OPS_USERNAME=ops-admin
V2_OPS_PASSWORD_HASH=scrypt$n=16384$r=8$p=1$REPLACE_SALT$REPLACE_DERIVED_KEY
V2_OPS_SESSION_KEY_HEX=REPLACE_64_LOWERCASE_HEX
V2_OPS_TRACE_KEY_HEX=REPLACE_64_LOWERCASE_HEX
V2_OPS_TRACE_PATH=/data/ops/v2-ops-trace.sqlite3
V2_OPS_SECURE_COOKIE=true
V2_OPS_DATA_DIR=/absolute/host/path/to/dedicated-ops-data
V2_OPS_IMAGE=agente-v2-ops:REPLACE_SHA
